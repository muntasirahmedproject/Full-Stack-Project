# Database Configuration
POSTGRES_USER=trip_user
POSTGRES_PASSWORD=change_this_secure_password_123
POSTGRES_DB=trip_planner

# Prisma Database Connection URL (points to 'db' container in docker network)
DATABASE_URL=postgresql://trip_user:change_this_secure_password_123@db:5432/trip_planner

# Backend Application Configuration
PORT=3000
JWT_SECRET=change_this_jwt_secret_key_456
FRONTEND_URL=*

# Frontend API URL Configuration (Set this to your AWS EC2 Public IP or Domain)
# Example: REACT_APP_API_URL=http://54.123.45.67:3001
REACT_APP_API_URL=http://localhost:3001
